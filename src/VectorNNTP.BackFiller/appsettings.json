{
  "BackFiller": {
    "Name": "backfiller",
    "DnsSuffix": "usenet.ninja",
    "BindAddress": [],
    "BindPort": 1190,
    "LogDirectory": "logs",
    "CertificateDirectory": "certs",
    "LetsEncrypt": {
      "AcmeAccountEmail": "security@usenet.ninja",
      "AcmeAccountKeyPem": "account.key",
      "AcmeTransientRetryMaxAttempts": 5,
      "ClockSkewCheckTtlMinutes": 5,
      "ClockSkewMaxMinutes": 10,
      "DnsAuthoritativeNsCacheMinutes": 5,
      "DnsAuthoritativeQuorumRatio": 0.7,
      "DnsPropagationDelaySeconds": 15,
      "DnsTxtPollIntervalSeconds": 3,
      "DnsTxtPollTimeoutSeconds": 600,
      "DomainNames": [],
      "RenewalCheckIntervalHours": 6,
      "RenewalJitterRatio": 0.1,
      "RenewBeforeExpiryDays": 7,
      "UseStagingDirectory": true
    },
    "RabbitMQ": {
      "Hosts": [ "127.0.0.1" ],
      "Port": 5672,
      "EnableSsl": false,
      "VirtualHost": "/",
      "WorkRequestMaxPayloadBytes": 1024,
      "ChannelLeaseTimeoutSeconds": 60,
      "RpcTimeoutSeconds": 30,
      "ConnectionBlockedTimeoutSeconds": 30,
      "ChannelPoolSize": 512,
      "MinConnections": 4,
      "MaxConnections": 16,
      "MaxConsecutiveRecoveryFailures": 5,
      "MaxPendingLeaseWaiters": 1024,
      "ConnectionScaleDownIdleSeconds": 300,
      "ScaleDownCooldownSeconds": 30,
      "NetworkRecoveryIntervalSeconds": 5,
      "PoolReconnectBaseDelayMs": 250,
      "PoolReconnectMaxDelayMs": 30000,
      "MinimumConnectionLifetimeSeconds": 300,
      "PublishConfirmTimeoutSeconds": 10,
      "MaximumShutdownDrainTimeoutSeconds": 30,
      "DegradedThreshold": 0.75,
      "UnhealthyThreshold": 5,
      "RequestedHeartbeatSeconds": 60,
      "SocketTimeoutSeconds": 30,
      "RequestedChannelMax": 2047
    },
    "TransitServer": {
      "Host": "localhost",
      "Port": 119,
      "UseSsl": false
    },
    "ArticleRetention": {
      "MaximumRetainedPayloadGigabytes": 4,
      "RetentionTtlSeconds": 60,
      "SweepIntervalSeconds": 1
    },
    "Shutdown": {
      "GracePeriodSeconds": 30,
      "DrainQueuedWork": true,
      "FinishActiveArticles": true
    },
    "Listener": {
      "ParserAccumulationMaxBytes": 262144,
      "TlsHandshakeTimeoutSeconds": 30,
      "IoProgressTimeoutSeconds": 60,
      "AwaitingReceiptAckTimeoutSeconds": 30,
      "MaxQueuedFoundPayloadBytes": 67108864,
      "MaxActiveConnections": 1024
    }
  },
  "Serilog": {
    "Enrich": [ "FromLogContext" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "VectorNNTP.BackFiller": "Information"
      }
    },
    "Properties": {
      "Application": "VectorNNTP.BackFiller"
    },
    "Using": [ "Serilog.Sinks.Console" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}",
          "restrictedToMinimumLevel": "Information"
        }
      }
    ]
  }
}
