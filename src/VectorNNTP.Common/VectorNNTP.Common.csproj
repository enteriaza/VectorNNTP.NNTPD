<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VectorNNTP.Common</RootNamespace>
    <AssemblyName>VectorNNTP.Common</AssemblyName>
    <Description>Shared ACME, Cloudflare DNS, bind-address, NntpDB, article-content primitives, Diablo article classification, ArticleRecord, ArticleId, OverviewDB protobuf wire contract, StorageServer cache-fleet advertisement JSON contract and topology name constants, byte-oriented article parsing, yEnc validation, canonical article materialization, Vector Article Transfer Protocol (VATP) framing, and RabbitMQ connectivity (connection lifecycle, channels) for VectorNNTP applications. RabbitMQ topology declaration, ArticleWork, and Management HTTP remain application-owned.</Description>
    <IsPackable>false</IsPackable>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VectorNNTP.Common.Tests" />
    <InternalsVisibleTo Include="VectorNNTP.NNTPD" />
    <InternalsVisibleTo Include="VectorNNTP.NNTPD.Tests" />
    <InternalsVisibleTo Include="VectorNNTP.BackFiller" />
    <InternalsVisibleTo Include="VectorNNTP.BackFiller.Tests" />
    <InternalsVisibleTo Include="VectorNNTP.StorageServer" />
    <InternalsVisibleTo Include="VectorNNTP.StorageServer.Tests" />
    <InternalsVisibleTo Include="VectorNNTP.StorageServer.PersistenceBench" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Blake3" Version="3.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="11.0.0-rc.1.26425.128" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0-rc.1.26425.128" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="11.0.0-rc.1.26425.128" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0-rc.1.26425.128" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0-rc.1.26425.128" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0-rc.1.26425.128" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0-rc.1.26425.128" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="11.0.0-rc.1.26425.128" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0-rc.1.26425.128" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="11.0.0-rc.1.26425.128" />
    <PackageReference Include="System.IO.Hashing" Version="11.0.0-rc.1.26425.128" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageReference Include="Serilog" Version="4.4.1-dev-02447" />
    <PackageReference Include="Serilog.Sinks.File" Version="8.0.0-nblumhardt-02322" />
  </ItemGroup>

</Project>
