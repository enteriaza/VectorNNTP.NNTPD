{
  "StorageServer": {
    "AcmeDirectoryUrl": "https://acme-v02.api.letsencrypt.org/directory",
    "AcmeRenewalThresholdDays": 14,
    "AcmeStateDir": "certs",
    "BindAddress": [
      "198.18.0.66",
      "2c0f:f030:1442:501:198:18:0:66"
    ],
    "BindPort": 0,
    "BindPortTls": 1191,
    "CloudFlareZoneId": "5811a29d39a0732afb5f160c9b137c3d",
    "DnsSuffix": "usenet.ninja",
    "GracefulShutdownTimeout": "00:00:30",
    "Listener": {
      "IoProgressTimeoutSeconds": 60,
      "MaxActiveConnections": 1024,
      "ParserAccumulationMaxBytes": 262144,
      "TlsHandshakeTimeoutSeconds": 30
    },
    "LogDir": "logs",
    "ServerId": 1,
    "StopHostOnUnexpectedServiceTermination": true,
    "Storage": {
      "ArticleCache": {
        "MaxBytes": 1073741824
      },
      "EgressCache": {
        "CapacityBytes": 0,
        "ReserveBytes": 0
      },
      "CacheDir": "spool/cache",
      "BulkPressure": {
        "CriticalPercent": 90,
        "EmergencyPercent": 95,
        "HighPercent": 85,
        "MinimumRetentionAge": "7.00:00:00",
        "OperationalReservePercent": 5,
        "PressurePercent": 80,
        "PressureRecoveryMarginPercent": 5,
        "RecoveryReservePercent": 5,
        "RewriteReservePercent": 10,
        "WarningPercent": 75
      },
      "Capacity": {
        "CompactionHeadroom": 10,
        "FreeCapacity": 5,
        "MaximumUsageCapacity": 50,
        "MaximumUtilization": 70
      },
      "Compaction": {
        "Interval": "00:01:00",
        "MinimumDeadBytes": 67108864,
        "MinimumDeadRatio": 10
      },
      "ControlDir": "spool/",
      "IndexCheckpointThresholdBytes": 134217728,
      "JournalCheckpointThresholdBytes": 33554432,
      "JournalHardLimitBytes": 134217728,
      "JournalSoftLimitBytes": 67108864,
      "ActiveSegmentCount": 1,
      "MaxRetentionAge": "00:00:00",
      "MaxSegmentSealDelay": "00:01:00",
      "SegmentTargetSizeBytes": 10737418240
    },
    "Systemd": {
      "EnableWatchdog": true,
      "NotifyReadyOnApplicationRunning": true,
      "NotifyStoppingOnApplicationShutdown": true,
      "ReportLifecycleStatus": true,
      "WatchdogIntervalFraction": 0.5
    }
  },
  "Serilog": {
    "Enrich": [ "FromLogContext" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "VectorNNTP.StorageServer": "Debug"
      }
    },
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Async" ],
    "WriteTo": [
      {
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}",
          "restrictedToMinimumLevel": "Debug"
        },
        "Name": "Console"
      },
      {
        "Args": {
          "blockWhenFull": true,
          "bufferSize": 50000,
          "configure": [
            {
              "Args": {
                "buffered": true,
                "flushToDiskInterval": "00:00:01",
                "fileSizeLimitBytes": null,
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}",
                "path": "/logs/pending-.log",
                "restrictedToMinimumLevel": "Debug",
                "retainedFileCountLimit": 14,
                "rollOnFileSizeLimit": false,
                "rollingInterval": "Day"
              },
              "Name": "File"
            }
          ]
        },
        "Name": "Async"
      }
    ]
  }
}
