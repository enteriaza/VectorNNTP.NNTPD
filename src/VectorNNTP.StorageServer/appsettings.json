{
  "StorageServer": {
    "ServerId": 1,
    "DnsSuffix": "usenet.ninja",
    "BindAddress": [
      "198.18.0.66",
      "2c0f:f030:1442:501:198:18:0:66"
    ],
    "BindPort": 0,
    "BindPortTls": 1191,
    "CloudFlareZoneId": "5811a29d39a0732afb5f160c9b137c3d",
    "AcmeDirectoryUrl": "https://acme-v02.api.letsencrypt.org/directory",
    "AcmeRenewalThresholdDays": 14,
    "AcmeStateDir": "certs",
    "LogDir": "/logs",
    "CacheDir": "cache/",
    "Storage": {
      "ControlDir": "control/",
      "JournalSoftLimitBytes": 67108864,
      "JournalHardLimitBytes": 134217728,
      "SegmentTargetSizeBytes": 268435456
    },
    "ApplicationName": "VectorNNTP.StorageServer",
    "GracefulShutdownTimeout": "00:00:30",
    "StopHostOnUnexpectedServiceTermination": true,
    "Listener": {
      "ParserAccumulationMaxBytes": 262144,
      "TlsHandshakeTimeoutSeconds": 30,
      "IoProgressTimeoutSeconds": 60,
      "MaxActiveConnections": 1024
    },
    "Systemd": {
      "EnableWatchdog": true,
      "NotifyReadyOnApplicationRunning": true,
      "NotifyStoppingOnApplicationShutdown": true,
      "ReportLifecycleStatus": true,
      "WatchdogIntervalFraction": 0.5
    }
  },
  "RabbitMQ": {
    "ChannelLeaseTimeoutSeconds": 60,
    "ChannelPoolSize": 512,
    "ConnectionBlockedTimeoutSeconds": 30,
    "ConnectionScaleDownIdleSeconds": 300,
    "DegradedThreshold": 0.75,
    "EnableSsl": false,
    "Hosts": [
      "198.18.0.3"
    ],
    "Management": {
      "BaseUrl": "http://198.18.0.3:15672",
      "RequestTimeoutSeconds": 5
    },
    "MaxConnections": 16,
    "MaximumShutdownDrainTimeoutSeconds": 30,
    "MaxPendingLeaseWaiters": 1024,
    "MinConnections": 4,
    "MinimumConnectionLifetimeSeconds": 300,
    "NetworkRecoveryIntervalSeconds": 5,
    "PoolReconnectBaseDelayMs": 250,
    "PoolReconnectMaxDelayMs": 30000,
    "Port": 5672,
    "PublishConfirmTimeoutSeconds": 10,
    "RequestedChannelMax": 2047,
    "RequestedHeartbeatSeconds": 60,
    "RpcTimeoutSeconds": 30,
    "ScaleDownCooldownSeconds": 30,
    "SocketTimeoutSeconds": 30,
    "UnhealthyThreshold": 5,
    "VirtualHost": "/"
  },
  "Serilog": {
    "Enrich": [ "FromLogContext" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "VectorNNTP.StorageServer": "Debug"
      }
    },
    "Properties": {
      "Application": "VectorNNTP.StorageServer"
    },
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Async", "Serilog.Sinks.File.Archive" ],
    "WriteTo": [
      {
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}",
          "restrictedToMinimumLevel": "Debug"
        },
        "Name": "Console"
      },
      {
        "Args": {
          "blockWhenFull": true,
          "bufferSize": 50000,
          "configure": [
            {
              "Args": {
                "buffered": true,
                "fileSizeLimitBytes": null,
                "hooks": "VectorNNTP.StorageServer.Logging.StorageServerSerilogHooks::DailyGzipFastest, VectorNNTP.StorageServer",
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}",
                "path": "/logs/VectorNNTP.StorageServer-.log",
                "restrictedToMinimumLevel": "Debug",
                "retainedFileCountLimit": 14,
                "rollOnFileSizeLimit": false,
                "rollingInterval": "Day"
              },
              "Name": "File"
            }
          ]
        },
        "Name": "Async"
      }
    ]
  }
}
