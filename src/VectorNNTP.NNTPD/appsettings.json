    "AcmeEmail": "savage@savage.za.org",
    "AcmeStateDir": "certs/",
    "LogDir": "logs/",
    "AcmeRenewalThresholdDays": 14,
    "AllowCleartextAuth": true,
    "ApplicationName": "VectorNNTP.NNTPD",
    "BindAddress": [ "198.18.0.66", "2c0f:f030:1442:501:198:18:0:66" ],
    "BindPort": 1199,
    "BindPortTls": 5633,
    "CloudFlareZoneId": "5811a29d39a0732afb5f160c9b137c3d",
    "DnsSuffix": "usenet.ninja",
    "GracefulShutdownTimeout": "00:01:00",
    "HistoryTime": "02:00:00",
    "IdleTime": 300,
    "ProxyHosts": [],
    "ServerId": 1,
    "StartupTimeout": null,
    "StopHostOnUnexpectedServiceTermination": true,
    "Systemd": {
      "EnableWatchdog": true,
      "ReportLifecycleStatus": true,
      "NotifyReadyOnApplicationRunning": true,
      "NotifyStoppingOnApplicationShutdown": true,
      "WatchdogIntervalFraction": 0.5
    },
    "TransitQueueMemoryLimit": 4294967296
  },
  "Redis": {
    "Host": [ "198.18.0.70" ],
    "Port": 6379
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Async", "Serilog.Sinks.File.Archive" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "VectorNNTP.NNTPD": "Debug"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "VectorNNTP.NNTPD"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Information",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Async",
        "Args": {
          "bufferSize": 50000,
          "blockWhenFull": true,
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "logs/VectorNNTP.NNTPD-.log",
                "restrictedToMinimumLevel": "Debug",
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}",
                "fileSizeLimitBytes": null,
                "buffered": true,
                "rollingInterval": "Day",
                "rollOnFileSizeLimit": false,
                "retainedFileCountLimit": 14,
                "hooks": "VectorNNTP.NNTPD.Logging.NntpdSerilogHooks::DailyGzipFastest, VectorNNTP.NNTPD"
              }
            }
          ]
        }
      }
    ]
  },
