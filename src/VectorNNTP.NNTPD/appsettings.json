{
  "Nntpd": {
    "ApplicationName": "VectorNNTP.NNTPD",
    "GracefulShutdownTimeout": "00:00:30",
    "StartupTimeout": null,
    "StopHostOnUnexpectedServiceTermination": true,
    "Systemd": {
      "EnableWatchdog": true,
      "ReportLifecycleStatus": true,
      "NotifyReadyOnApplicationRunning": true,
      "NotifyStoppingOnApplicationShutdown": true,
      "WatchdogIntervalFraction": 0.5
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "VectorNNTP.NNTPD": "Information"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "VectorNNTP.NNTPD"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
